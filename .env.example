# ComfyUI Destination Server Base URL (e.g. https://comfy.yourdomain.com or http://localhost:8188)
DESTINATION_SERVER_URL=https://comfy.yourdomain.com

# Dashboard Admin Credentials (for HTTP Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Server Port
PORT=8000

# SQLite Database File Path
DB_PATH=data/logs.db
